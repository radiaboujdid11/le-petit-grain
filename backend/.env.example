# Modèle du fichier .env (versionné, SANS secrets).
# Copier ce fichier en « .env » puis adapter les valeurs. Le .env n'est jamais commité.

# Environnement : development | test | production
ENVIRONMENT=development

# Adresse du frontend autorisée par CORS (une seule origine)
FRONTEND_ORIGIN=http://localhost:3000

# Base PostgreSQL (celle de docker-compose.yml en local)
DATABASE_URL=postgresql+psycopg://lpg:lpg_dev_password@localhost:5432/lepetitgrain
