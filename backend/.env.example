# Modèle du fichier .env (versionné, SANS secrets).
# Copier ce fichier en « .env » puis adapter les valeurs. Le .env n'est jamais commité.

# Environnement : development | test | production
ENVIRONMENT=development

# Adresse du frontend autorisée par CORS (une seule origine)
FRONTEND_ORIGIN=http://localhost:3000

# Base PostgreSQL (celle de docker-compose.yml en local)
DATABASE_URL=postgresql+psycopg://lpg:lpg_dev_password@localhost:5432/lepetitgrain

# E-mails (https://resend.com). Sans clé : aucun e-mail envoyé.
RESEND_API_KEY=
# Adresse du café, prévenue à chaque commande, réservation et message
NOTIFY_EMAIL=
# Confirmations aux clients : true seulement après avoir vérifié un domaine dans Resend
# (et changé EMAIL_FROM, ex. "Le Petit Grain <bonjour@lepetitgrain.ma>")
CUSTOMER_EMAILS=false
